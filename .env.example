# Port the StoryBored server listens on
STORYBORED_PORT=8600

# Network interface to bind. Default 127.0.0.1 = localhost only (reachable from
# this machine alone). There is NO login or authentication, so only set this to
# 0.0.0.0 (open to your LAN) on a network you trust — never on the open internet.
STORYBORED_HOST=127.0.0.1

# sqlite db + media + exports live here
DATA_DIR=./data

# URL of the ComfyUI instance that does the generating (can be another machine)
COMFYUI_URL=http://127.0.0.1:8188

# optional: where to copy imported character LoRAs so ComfyUI can find them
# (also editable at runtime in Settings — the Settings value wins)
COMFY_LORAS_DIR=

# optional: ComfyUI's base models directory (contains diffusion_models/,
# text_encoders/, vae/, loras/). Only meaningful when StoryBored runs on the
# same machine/filesystem as ComfyUI — enables the in-app model downloader
# ("Download" buttons on missing files in Settings) and big-model warnings
COMFY_MODELS_DIR=

# optional shell cmd run before image jobs (e.g. a GPU profile switcher)
COMFY_MODE_IMAGE_CMD=

# optional shell cmd run before video jobs
COMFY_MODE_VIDEO_CMD=

# optional shell cmd run between model-family switches
COMFY_FLUSH_CMD=

# optional: OpenAI-compatible LLM for script breakdown, e.g. http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# optional, Ollama only: keep_alive passed on every chat call. "0" frees the
# model from VRAM immediately after each call (good on a GPU shared with the
# render engine), "10m" keeps it warm. Leave empty for other providers.
LLM_KEEP_ALIVE=

# optional: path to a local lora-factory checkout that enables character training
LORA_FACTORY_DIR=
